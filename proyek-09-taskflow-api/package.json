{
  "name": "taskflow-api",
  "version": "1.0.0",
  "private": true,
  "description": "TaskFlow API — aplikasi manajemen tugas dengan Express, SQLite, dan frontend vanilla JavaScript.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
